rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Forgot-password requests (see "Forgot password, with no email on the
    // account" in index.html, and api/reset.js). Anyone, signed in or not, can
    // leave one and can look at one whose id they know (ids are random; that
    // is how the browser that asked sees the answer). Only the admin's account
    // can list them, answer them or clear them. Changing the password itself
    // is done by the server function, which these rules don't apply to.
    match /resetRequests/{requestId} {
      function isAdmin() { return isSignedIn() && request.auth.token.email == "huey@chatclub.local"; }
      allow create: if request.resource.data.keys().hasOnly(["name", "keyHash", "status", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.keyHash is string && request.resource.data.keyHash.size() == 64
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
      allow get: if true;
      allow list, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "allowedAt"])
        && request.resource.data.status in ["allowed", "denied"];
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() &&
        (request.auth.uid in resource.data.memberIds || request.auth.uid in resource.data.pendingIds);
      allow update: if isSignedIn() &&
        (request.auth.uid in resource.data.memberIds || request.auth.uid in resource.data.pendingIds);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        allow read: if isSignedIn() && request.auth.uid in parentGroup().memberIds;
        allow create: if isSignedIn() && request.auth.uid in parentGroup().memberIds
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && request.auth.uid in parentGroup().memberIds && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions", "poll"])
        );
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }

      match /typing/{uid} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        allow read: if isSignedIn() && request.auth.uid in parentGroup().memberIds;
        allow write: if isSignedIn() && request.auth.uid == uid && request.auth.uid in parentGroup().memberIds;
      }

      match /calls/{callId} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        allow read, write: if isSignedIn() && request.auth.uid in parentGroup().memberIds;
      }
    }
  }
}
